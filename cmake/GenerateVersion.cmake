# Derives ag's version and writes it to AG_VERSION_HEADER.
#
# The base version is the one declared in configure.ac, so a source tarball and
# a Git checkout agree. A checkout that is not exactly on a tag appends the
# distance from the last tag and the short commit, and marks a dirty tree, which
# keeps every CI package identifiable.
#
# Run with:
#   cmake -DAG_SOURCE_DIR=... -DAG_VERSION_HEADER=... -P GenerateVersion.cmake

cmake_minimum_required(VERSION 3.16)

foreach(required AG_SOURCE_DIR AG_VERSION_HEADER)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "GenerateVersion.cmake requires ${required}")
  endif()
endforeach()

file(STRINGS "${AG_SOURCE_DIR}/configure.ac" configure_lines)
set(base_version "")
foreach(line IN LISTS configure_lines)
  if(line MATCHES "^[ \t]*\\[([0-9]+\\.[0-9]+\\.[0-9]+)\\],?[ \t]*$")
    set(base_version "${CMAKE_MATCH_1}")
    break()
  endif()
endforeach()
if(base_version STREQUAL "")
  message(FATAL_ERROR "Could not read ag's version from configure.ac")
endif()

set(version "${base_version}")
find_package(Git QUIET)
if(GIT_FOUND)
  execute_process(
    COMMAND "${GIT_EXECUTABLE}" -C "${AG_SOURCE_DIR}" describe --tags --long --always --dirty
    OUTPUT_VARIABLE describe
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE describe_status
    ERROR_QUIET
  )
  execute_process(
    COMMAND "${GIT_EXECUTABLE}" -C "${AG_SOURCE_DIR}" rev-parse --short=8 HEAD
    OUTPUT_VARIABLE commit
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE commit_status
    ERROR_QUIET
  )

  if(describe_status EQUAL 0 AND commit_status EQUAL 0)
    set(tag "")
    set(distance 0)
    if(describe MATCHES "^(.+)-([0-9]+)-g[0-9A-Fa-f]+(-dirty)?$")
      set(tag "${CMAKE_MATCH_1}")
      set(distance "${CMAKE_MATCH_2}")
    endif()
    set(dirty FALSE)
    if(describe MATCHES "-dirty$")
      set(dirty TRUE)
    endif()

    # A tag is the authority on a release's version; configure.ac is the
    # fallback for an untagged tree and for a tag that is not a bare version.
    if(NOT tag STREQUAL "")
      string(REGEX REPLACE "^[vV]" "" tag_version "${tag}")
      if(tag_version MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+")
        set(base_version "${tag_version}")
      endif()
    endif()

    if(NOT tag STREQUAL "" AND distance EQUAL 0 AND NOT dirty)
      # Exactly on a tag with a clean tree: the release version, unqualified.
      set(version "${base_version}")
    else()
      set(version "${base_version}-dev.${distance}+${commit}")
      if(dirty)
        set(version "${version}.dirty")
      endif()
    endif()
  endif()
endif()

set(generated "\
/* Generated by cmake/GenerateVersion.cmake. Do not edit. */\n\
#ifndef AG_VERSION_H\n\
#define AG_VERSION_H\n\
\n\
#define AG_VERSION \"${version}\"\n\
#define AG_BASE_VERSION \"${base_version}\"\n\
\n\
#endif\n")

set(existing "")
if(EXISTS "${AG_VERSION_HEADER}")
  file(READ "${AG_VERSION_HEADER}" existing)
endif()
if(NOT existing STREQUAL generated)
  file(WRITE "${AG_VERSION_HEADER}" "${generated}")
endif()

if(DEFINED AG_VERSION_FILE AND NOT "${AG_VERSION_FILE}" STREQUAL "")
  file(WRITE "${AG_VERSION_FILE}" "${version}")
endif()
message(STATUS "ag version: ${version}")
