{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchains/tcc-windows.cmake"
    },
    {
      "name": "debug-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "x86-debug",
      "displayName": "x86 Debug",
      "inherits": "debug-base",
      "cacheVariables": {
        "AG_ARCH": "x86"
      }
    },
    {
      "name": "x64-debug",
      "displayName": "x64 Debug",
      "inherits": "debug-base",
      "cacheVariables": {
        "AG_ARCH": "x64"
      }
    },
    {
      "name": "arm64-debug",
      "displayName": "ARM64 Debug",
      "inherits": "debug-base",
      "cacheVariables": {
        "AG_ARCH": "arm64"
      }
    },
    {
      "name": "x86-release",
      "displayName": "x86 Release",
      "inherits": "release-base",
      "cacheVariables": {
        "AG_ARCH": "x86"
      }
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release",
      "inherits": "release-base",
      "cacheVariables": {
        "AG_ARCH": "x64"
      }
    },
    {
      "name": "arm64-release",
      "displayName": "ARM64 Release",
      "inherits": "release-base",
      "cacheVariables": {
        "AG_ARCH": "arm64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x86-debug",
      "configurePreset": "x86-debug"
    },
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug"
    },
    {
      "name": "arm64-debug",
      "configurePreset": "arm64-debug"
    },
    {
      "name": "x86-release",
      "configurePreset": "x86-release"
    },
    {
      "name": "x64-release",
      "configurePreset": "x64-release"
    },
    {
      "name": "arm64-release",
      "configurePreset": "arm64-release"
    },
    {
      "name": "package-x86-debug",
      "configurePreset": "x86-debug",
      "targets": [
        "wpm-package"
      ]
    },
    {
      "name": "package-x64-debug",
      "configurePreset": "x64-debug",
      "targets": [
        "wpm-package"
      ]
    },
    {
      "name": "package-arm64-debug",
      "configurePreset": "arm64-debug",
      "targets": [
        "wpm-package"
      ]
    },
    {
      "name": "package-x86-release",
      "configurePreset": "x86-release",
      "targets": [
        "wpm-package"
      ]
    },
    {
      "name": "package-x64-release",
      "configurePreset": "x64-release",
      "targets": [
        "wpm-package"
      ]
    },
    {
      "name": "package-arm64-release",
      "configurePreset": "arm64-release",
      "targets": [
        "wpm-package"
      ]
    }
  ]
}
